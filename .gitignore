```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map

# Environment variables
.env
.env.local
*.env.*

# IDE specific
.vscode/
.idea/
*.swp
*.swo

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log

# Coverage reports
coverage/
htmlcov/
*.coverage

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
.coverage.*

# Temporary files
*.tmp
*~

# Compressed files
*.zip
*.tar.gz
*.tar.bz2
*.tar.xz
*.gz
*.rar
*.7z
```